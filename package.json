{
  "name": "fingertouch",
  "productName": "Dix Doigts",
  "version": "1.0.0",
  "description": "Entraînement à la frappe à dix doigts : leçons progressives, clavier coloré par doigt et suivi de vitesse.",
  "main": "src/main.js",
  "author": {
    "name": "Tototra",
    "email": "tototra@users.noreply.github.com"
  },
  "homepage": "https://github.com/Tototra/fingertouch",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.tototra.fingertouch",
    "productName": "Dix Doigts",
    "artifactName": "DixDoigts-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "app/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "Tototra",
      "repo": "fingertouch",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DixDoigts-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "DixDoigts-${version}-windows-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "category": "Education",
      "maintainer": "Tototra <tototra@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "syncDesktopName": true
    }
  },
  "desktopName": "dix-doigts.desktop"
}
